# Preserve upstream multiline diagnostic strings in the generated AWS SDK chunk.
# Application source still receives the normal whitespace checks.
dev/nest-quest/assets/cloud-*.js whitespace=-blank-at-eol
# Three.js embeds upstream GLSL strings with intentional shader indentation.
dev/nest-quest/assets/three.module-*.js whitespace=-blank-at-eol,-space-before-tab
