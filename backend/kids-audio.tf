data "aws_caller_identity" "current" {}

data "archive_file" "kids_audio" {
  type        = "zip"
  source_dir  = "${path.module}/kids-audio/src"
  output_path = "${path.module}/.terraform-build/kids-audio.zip"
  excludes    = ["test/**"]
}

resource "aws_cloudwatch_log_group" "kids_audio" {
  name              = "/aws/lambda/tpc-kids-audio"
  retention_in_days = 14
}

resource "aws_iam_role" "kids_audio" {
  name = "tpc-kids-audio"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy" "kids_audio" {
  name = "tpc-kids-audio-prikazki-only"
  role = aws_iam_role.kids_audio.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "${aws_cloudwatch_log_group.kids_audio.arn}:*"
      },
      {
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = aws_s3_bucket.uploads.arn
        Condition = {
          StringLike = { "s3:prefix" = ["prikazki/", "prikazki/*"] }
        }
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject"]
        Resource = "${aws_s3_bucket.uploads.arn}/prikazki/*"
      }
    ]
  })
}

resource "aws_lambda_function" "kids_audio" {
  function_name    = "tpc-kids-audio"
  description      = "Builds a private audio manifest and serves on-demand playback redirects."
  role             = aws_iam_role.kids_audio.arn
  runtime          = "nodejs22.x"
  handler          = "index.handler"
  filename         = data.archive_file.kids_audio.output_path
  source_code_hash = data.archive_file.kids_audio.output_base64sha256
  memory_size      = 128
  timeout          = 15
  environment {
    variables = {
      BUCKET_NAME       = aws_s3_bucket.uploads.bucket
      PREFIX            = "prikazki/"
      MANIFEST_KEY      = "prikazki/manifest.json"
      PRESIGNED_SECONDS = "43200"
    }
  }

  depends_on = [
    aws_iam_role_policy.kids_audio,
    aws_cloudwatch_log_group.kids_audio,
  ]
}

resource "aws_lambda_permission" "kids_audio_s3" {
  statement_id   = "AllowPrikazkiBucketEvents"
  action         = "lambda:InvokeFunction"
  function_name  = aws_lambda_function.kids_audio.function_name
  principal      = "s3.amazonaws.com"
  source_arn     = aws_s3_bucket.uploads.arn
  source_account = data.aws_caller_identity.current.account_id
}

resource "aws_s3_bucket_notification" "kids_audio" {
  bucket = aws_s3_bucket.uploads.id

  lambda_function {
    lambda_function_arn = aws_lambda_function.kids_audio.arn
    events              = ["s3:ObjectCreated:*", "s3:ObjectRemoved:*"]
    filter_prefix       = "prikazki/"
  }

  depends_on = [aws_lambda_permission.kids_audio_s3]
}

resource "aws_lambda_function_url" "kids_audio" {
  function_name      = aws_lambda_function.kids_audio.function_name
  authorization_type = "NONE"

  cors {
    allow_origins = concat(
      var.cors_allowed_origins,
      ["http://localhost:5189", "http://127.0.0.1:5189"]
    )
    allow_methods = ["GET"]
    max_age       = 3600
  }
}

resource "local_file" "kids_audio_config" {
  filename             = "${path.module}/../dev/kids/config.js"
  file_permission      = "0644"
  directory_permission = "0755"

  content = <<-EOT
    // GENERATED by Terraform (backend/kids-audio.tf). Public endpoint only; no secrets.
    window.__KIDS_AUDIO__ = {
      endpoint: ${jsonencode(trimsuffix(aws_lambda_function_url.kids_audio.function_url, "/"))},
    };
  EOT
}

output "kids_audio_endpoint" {
  description = "Public read-only endpoint for the audio manifest and on-demand playback redirects."
  value       = aws_lambda_function_url.kids_audio.function_url
}
